# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file types
*.tex text eol=lf
*.bib text eol=lf
*.cls text eol=lf
*.sty text eol=lf
*.bst text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
.latexmkrc text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Binary files - do not touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
